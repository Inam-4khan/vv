PORT=3000
FRONTEND_URL=http://localhost:3000

# Cloud SQL PostgreSQL database connection
SQL_HOST=your_db_host_here
SQL_USER=your_db_user_here
SQL_PASSWORD=your_db_password_here
SQL_DB_NAME=your_db_name_here

# Drizzle Kit admin credentials
SQL_ADMIN_USER=your_admin_user_here
SQL_ADMIN_PASSWORD=your_admin_password_here

# Firebase Client Config
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_API_KEY=your_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_domain_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_OAUTH_CLIENT_ID=your_oauth_client_id_here
VITE_API_URL=your_api_url_here

# Firebase Admin SDK secrets
FIREBASE_PROJECT_ID=your_project_id_here
